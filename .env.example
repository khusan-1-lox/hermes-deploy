# Скопируй в .env и заполни. На Render переменные задаются в Dashboard.
HERMES_HOME=/home/hermes/.hermes

# === Провайдеры (нужен хотя бы один) ===
# Бесплатно через OpenRouter free tier
OPENROUTER_API_KEY=

# Дёшево: MiniMax, DeepSeek
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Канал мессенджера для gateway (опционально) ===
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
WHATSAPP_TOKEN=

# === Модель по умолчанию ===
HERMES_MODEL=openrouter/deepseek/deepseek-chat-v3.1:free